# Build output
target/
node_modules/
dist/

# The program keypair. It only signs the very first deploy — upgrades are authorised by the
# upgrade authority — but it is still a private key and does not belong in a repo. Back it up
# somewhere else; losing it means the program can never be deployed at this address again.
keys/

# Recorded by the sheet tool while its dev server runs; regenerates itself.
tools/sheet/analytics-history.*.jsonl

# Local machine state
.DS_Store
.claude/settings.local.json

# Local test wallets — regenerated by test-wallets.mjs, never committed (the old set leaked and was rotated).
scripts/.test-wallets.json
